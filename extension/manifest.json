
{
  "manifest_version": 3,
  "name": "SmartContractAnalyzer",
  "version": "1.0.0",
  "description": "Analyze Terms and Conditions and Privacy Policies while browsing.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "tabs",
    "scripting",
    "storage"
  ],
  
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8000/*",
    "https://www.spotify.com/*",
    "https://spotify.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open SmartContractAnalyzer"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
